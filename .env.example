# PostgreSQL connection used by Prisma and the application
# Direct/session URL for Prisma schema operations (same URL for local PostgreSQL)
DIRECT_URL=postgresql://user:password@localhost:5432/mch_monitoring?schema=public
DATABASE_URL=postgresql://mch_user:change-me@localhost:5432/mch_monitoring?schema=public

# Disposable PostgreSQL database used by npm test
TEST_DATABASE_URL=postgresql://mch_test:change-me@localhost:5432/mch_monitoring_test?schema=public

AUTH_SECRET=replace-with-a-long-random-secret

# SMS reminders use the console provider locally. Set SMS_PROVIDER=twilio and
# provide Twilio credentials to send real SMS messages.
SMS_PROVIDER=console
SMS_DEFAULT_COUNTRY_CODE=+234
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
